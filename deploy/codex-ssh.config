# 复制到 ~/.ssh/config（chmod 600）
# 私钥：~/.ssh/id_ed25519（勿提交 Git、勿写入 Codex 对话）

Host yiqi-nas
  HostName 192.168.2.224
  User Bely
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new

Host yiqi-cloud
  HostName 43.139.172.61
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new

# 云端 MySQL（Navicat / 本地）：先开隧道，再连 127.0.0.1:3307
Host yiqi-cloud-mysql
  HostName 43.139.172.61
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  LocalForward 3307 127.0.0.1:3306
