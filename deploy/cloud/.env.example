# 复制为 .env 后填写（chmod 600 .env，勿提交 Git）
# 一键生成空白模板：./scripts/gen-secrets.sh

# ---------- 域名（Caddy 自动 HTTPS）----------
SITE_DOMAIN=yiqi.example.com
ADMIN_DOMAIN=admin.yiqi.example.com
ACME_EMAIL=you@example.com

# ---------- 代码路径（服务器上 clone 后的目录）----------
PRIMORDIAL_WEB_ROOT=/opt/yiqi/Primordial_WEB
PRIMORDIAL_API_ROOT=/opt/yiqi/Primordial_API

# ---------- MySQL（仅 Docker 内网，不暴露公网）----------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=primordial_culture
MYSQL_USER=primordial

# ---------- JWT（至少 32 字符，用户端与管理端请用不同值）----------
JWT_SECRET_WEB=
JWT_SECRET_ADMIN=

# ---------- 发版 ----------
YIQI_NO_CACHE=0
GIT_BRANCH=main
