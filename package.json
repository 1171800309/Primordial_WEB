{
  "name": "primordial-web-monorepo",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix web",
    "dev:web": "npm run dev --prefix web",
    "dev:admin": "npm run dev --prefix admin",
    "build": "npm run build --prefix web",
    "build:admin": "npm run build --prefix admin",
    "build:all": "npm run build && npm run build:admin",
    "docker:web": "docker build -t primordial-web ./web",
    "docker:admin": "docker build -t primordial-admin ./admin",
    "docker:all": "npm run docker:web && npm run docker:admin"
  }
}
